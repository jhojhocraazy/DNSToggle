	<string name="connectivity_watchdog_debounce_custom">Personalizado…</string>
	<!-- Mensagem de erro de validação ao informar um tempo de espera inválido. -->
	<string name="connectivity_watchdog_debounce_invalid">Insira um valor entre 5 e 300 segundos</string>
	<!-- Texto formatado que exibe o tempo de espera selecionado em segundos. %d é o número de segundos. -->
	<string name="connectivity_watchdog_debounce_seconds_format">%d s</string>
	<!-- Texto da notificação quando o monitor desativa o DNS automaticamente. %s é o nome da rede. -->
	<string name="notif_connectivity_watchdog_disabled">DNS privado desativado e perfil de Wi-Fi adicionado para %s devido a um problema de conexão</string>
	<!-- Texto da notificação quando o monitor restaura o DNS após a conexão voltar. %s é o nome da rede. -->
	<string name="notif_connectivity_watchdog_restored">Conexão restabelecida. DNS privado reativado para %s</string>
	<!-- Texto de aviso que explica por que as permissões de localização são necessárias para os perfis de Wi-Fi. -->
	<string name="grant_permission_notice">É necessária a permissão de Localização/Dispositivos por perto (inclusive em segundo plano) para verificar o nome da rede Wi-Fi.</string>
	<!-- Texto do botão para solicitar as permissões necessárias. -->
	<string name="grant_permission_button">Conceder permissões</string>
	<!-- Mensagem do diálogo exibida quando as permissões de localização são negadas permanentemente. -->
	<string name="permissions_permanently_denied">As permissões de Localização e Dispositivos por perto foram negadas permanentemente. Ative-as nas configurações do app para usar este recurso.</string>
	<!-- Mensagem do diálogo que explica por que as permissões de notificação são necessárias. -->
	<string name="notification_permission_explanation">Para receber avisos quando o DNS privado for alternado automaticamente em segundo plano e manter o monitoramento ativo, permita as notificações.</string>
