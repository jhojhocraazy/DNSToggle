	<string name="ssid_hint">Nome da rede</string>
	<!-- Exemplo de preenchimento do campo do nome da rede Wi-Fi. -->
	<string name="ssid_placeholder">Nome da rede Wi-Fi</string>
	<!-- Aviso breve exibido quando um perfil de Wi-Fi é salvo. -->
	<string name="ssid_saved">Perfil de Wi-Fi salvo</string>
	<!-- Mensagem de confirmação do diálogo ao excluir um perfil de Wi-Fi. -->
	<string name="delete_ssid_confirm">Excluir este perfil de Wi-Fi?</string>

