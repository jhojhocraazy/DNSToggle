	<string name="profile_dns_section_header">Provedor de DNS privado</string>
	<!-- Rótulo do botão de opção do DNS padrão. %s é o nome do host padrão. -->
	<string name="default_dns_with_host_format">Padrão (%s)</string>
	<!-- Título da opção que ativa o monitor de conectividade. -->
	<string name="connectivity_watchdog_toggle">Bloquear o DNS privado em redes incompatíveis</string>
	<!-- Texto informativo que explica o monitor de conectividade. -->
	<string name="connectivity_watchdog_info_text">Quando o DNS privado falhar, mas a internet continuar disponível, o app desativará automaticamente o DNS privado na rede atual para restaurar a conexão.</string>
	<!-- Título da opção do tempo de espera antes de o monitor de conectividade desativar o DNS. -->
	<string name="connectivity_watchdog_debounce_label">Aguardar antes de desativar</string>
	<!-- Título da opção dos servidores usados para verificar a conectividade com a internet. -->
	<string name="connectivity_watchdog_targets_label">Servidores de teste de conexão</string>
	<!-- Título do diálogo para editar os servidores de destino do monitor de conectividade. -->
	<string name="connectivity_watchdog_targets_title">Servidores de destino da verificação de conectividade</string>
	<!-- Dica do campo de entrada dos servidores de destino do monitor de conectividade. -->
	<string name="connectivity_watchdog_targets_hint">Endereços IP</string>
	<!-- Exemplo de preenchimento do campo dos servidores de destino do monitor de conectividade. -->
	<string name="connectivity_watchdog_targets_placeholder">9.9.9.9, 5.1.66.255</string>
