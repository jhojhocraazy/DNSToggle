	<!-- Interface principal - perfis de Wi-Fi e monitoramento -->
	<!-- Título da seção para gerenciar regras de DNS específicas de cada rede. -->
	<string name="wifi_profiles_title">Perfis de Wi-Fi</string>
	<!-- Texto de resumo da seção que explica os perfis de Wi-Fi. -->
	<string name="wifi_profiles_summary">Defina regras específicas de DNS privado ou exceções para redes Wi-Fi individuais.</string>
	<!-- Título do diálogo que explica o serviço de monitoramento de Wi-Fi em segundo plano. -->
	<string name="wifi_monitoring_info_title">Sobre o monitoramento de Wi-Fi</string>
	<!-- Corpo do diálogo que explica o serviço de monitoramento de Wi-Fi em segundo plano. -->
	<string name="wifi_monitoring_info_text">Para permitir a troca automática, o app monitora mudanças de rede. O impacto no consumo de bateria deve ser mínimo, mas o sistema ainda pode indicar atividade em segundo plano.</string>
	<!-- Texto do diálogo que explica que as otimizações de bateria podem encerrar o serviço em segundo plano. -->
	<string name="battery_optimization_explanation">Alguns dispositivos encerram o monitoramento em segundo plano para economizar bateria. Se a automação parar de funcionar, desative as restrições para este app.</string>
	<!-- Texto do botão que abre as configurações de otimização de bateria do Android. -->
	<string name="ignore_battery_optimizations">Desativar restrições de bateria</string>
	<!-- Título da opção que salva automaticamente o estado do DNS privado por rede Wi-Fi. -->
	<string name="auto_save_state_title">Salvar automaticamente o estado do DNS privado (ligado/desligado)</string>
	<!-- Resumo da opção que salva automaticamente o estado do DNS privado. -->
	<string name="auto_save_state_summary">Lembrar quando o DNS privado for ativado ou desativado manualmente em redes Wi-Fi específicas.</string>
	<!-- Título da opção que salva automaticamente nomes do host de DNS por rede Wi-Fi. -->
	<string name="auto_save_host_title">Salvar automaticamente os nomes do host DNS</string>
	<!-- Resumo da opção que salva automaticamente nomes do host de DNS. -->
	<string name="auto_save_host_summary">Lembrar quando um provedor de DNS personalizado específico for selecionado em uma rede Wi-Fi.</string>
